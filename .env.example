# Your team key from @KJ on the Visko Discord. Server-side only.
REACTOR_API_KEY=replace_me

# Claude API key for the story director. Without it (and without an OpenAI key) prompts fall back to a simple template.
ANTHROPIC_API_KEY=

# OpenAI key: voice (TTS) and mic transcription (always required for those), and optionally the story director. Claude wins if both keys are set,
# unless DIRECTOR_PROVIDER=openai. Model and reasoning effort are configurable.
OPENAI_API_KEY=
# DIRECTOR_PROVIDER=openai
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=medium

# How long one Orbis session may run before it is re-created (seconds).
ORBIS_SESSION_SECONDS=1800

# Max portals open at once (each one is its own Orbis stream).
MAX_PORTALS=3

