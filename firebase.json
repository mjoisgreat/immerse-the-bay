{
  "hosting": {
    "site": "livingwindow",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "living-window-api", "region": "us-central1" } }
    ],
    "headers": [
      { "source": "/api/**", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
    ]
  }
}
