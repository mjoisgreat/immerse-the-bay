{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/relay.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/test1",
      "destination": "https://living-window-test1.vercel.app/",
      "permanent": false
    },
    {
      "source": "/test1/:path*",
      "destination": "https://living-window-test1.vercel.app/:path*",
      "permanent": false
    }
  ]
}
